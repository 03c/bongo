diff --git a/ggml/src/ggml-ple-reader.cpp b/ggml/src/ggml-ple-reader.cpp
new file mode 100644
index 000000000..15fb1b792
--- /dev/null
+++ b/ggml/src/ggml-ple-reader.cpp
@@ -0,0 +1,419 @@
+// M3.4b PLE reader implementation.  See ggml-ple-reader.h.
+//
+// Design (mirrors bench/ple_reader.py from BAS-77):
+//   * one O_DIRECT fd per registered tensor
+//   * a fixed pool of worker threads issuing page-aligned reads
+//   * page-aligned bounce buffers, reused across the whole run
+//   * a bounded LRU cache of raw rows
+//   * a bounded window of in-flight reads per gather wave
+//
+// A gathered row may straddle a page boundary, so each miss is served by one
+// read of the 1-2 pages that cover it.  Requests are de-duplicated by their
+// aligned start so a prefill chunk reads each page once.
+
+#include "ggml-ple-reader.h"
+
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#if defined(__linux__)
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+#if defined(__linux__)
+
+constexpr uint64_t kPageGuess = 4096;
+
+struct ReadTask {
+    uint64_t  off = 0;  // page-aligned file offset
+    uint64_t  len = 0;  // multiple of the block size
+    uint8_t * buf = nullptr;
+};
+
+// persistent worker pool: run() hands it a batch, workers pread, run() waits.
+class IOPool {
+public:
+    explicit IOPool(int n) : n_workers(n < 1 ? 1 : n) {
+        workers.reserve((size_t) n_workers);
+        for (int i = 0; i < n_workers; ++i) {
+            workers.emplace_back([this] { worker(); });
+        }
+    }
+
+    ~IOPool() {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop = true;
+        }
+        cv_work.notify_all();
+        for (auto & w : workers) {
+            if (w.joinable()) {
+                w.join();
+            }
+        }
+    }
+
+    void run(int fd, std::vector<ReadTask> & tasks, std::vector<int> & task_error) {
+        if (tasks.empty()) {
+            return;
+        }
+        std::unique_lock<std::mutex> lk(m);
+        cur_fd    = fd;
+        current   = &tasks;
+        errors    = &task_error;
+        next      = 0;
+        completed = 0;
+        done      = false;
+        cv_work.notify_all();
+        cv_done.wait(lk, [this] { return done; });
+        current = nullptr;
+        errors  = nullptr;
+        cv_work.notify_all();
+    }
+
+    int size() const { return n_workers; }
+
+private:
+    void worker() {
+        std::unique_lock<std::mutex> lk(m);
+        while (!stop) {
+            cv_work.wait(lk, [this] { return stop || current != nullptr; });
+            if (stop) {
+                return;
+            }
+            auto *   batch = current;
+            auto *   errs  = errors;
+            const int fd   = cur_fd;
+            const size_t n = batch->size();
+            for (;;) {
+                const size_t i = next++;
+                if (i >= n) {
+                    break;
+                }
+                lk.unlock();
+                ReadTask & t = (*batch)[i];
+                ssize_t got = 0;
+                do {
+                    got = pread(fd, t.buf, (size_t) t.len, (off_t) t.off);
+                } while (got == -1 && errno == EINTR);
+                if (got < 0) {
+                    (*errs)[i] = errno;
+                } else if ((size_t) got < t.len) {
+                    // only the tail of the aligned span ran past EOF; the rows we
+                    // need end inside the file, so zero the padding
+                    std::memset(t.buf + got, 0, (size_t) (t.len - (size_t) got));
+                }
+                lk.lock();
+                if (++completed == n) {
+                    done = true;
+                    cv_done.notify_one();
+                }
+            }
+            // hold here until the caller has copied the batch out
+            cv_work.wait(lk, [this] { return stop || current == nullptr; });
+        }
+    }
+
+    int cur_fd = -1;
+    int n_workers = 0;
+
+    std::mutex               m;
+    std::condition_variable  cv_work;
+    std::condition_variable  cv_done;
+    std::vector<std::thread> workers;
+    std::vector<ReadTask> *  current = nullptr;
+    std::vector<int> *       errors  = nullptr;
+    size_t                   next = 0;
+    size_t                   completed = 0;
+    bool                     done = false;
+    bool                     stop = false;
+};
+
+// bounded LRU of raw rows keyed by global row id
+class RowCache {
+public:
+    explicit RowCache(uint64_t cap) : cap_(cap == 0 ? 1 : cap) {}
+
+    bool get(int64_t row, uint8_t * dst, uint64_t row_bytes) {
+        auto it = map_.find(row);
+        if (it == map_.end()) {
+            return false;
+        }
+        lru_.splice(lru_.begin(), lru_, it->second);
+        std::memcpy(dst, it->second->data.data(), (size_t) row_bytes);
+        return true;
+    }
+
+    void put(int64_t row, const uint8_t * src, uint64_t row_bytes) {
+        auto it = map_.find(row);
+        if (it != map_.end()) {
+            lru_.splice(lru_.begin(), lru_, it->second);
+            return;
+        }
+        lru_.emplace_front();
+        lru_.front().row  = row;
+        lru_.front().data.assign(src, src + row_bytes);
+        map_[row] = lru_.begin();
+        while (map_.size() > cap_) {
+            auto last = std::prev(lru_.end());
+            map_.erase(last->row);
+            lru_.pop_back();
+        }
+    }
+
+private:
+    struct Entry {
+        int64_t              row = 0;
+        std::vector<uint8_t> data;
+    };
+    uint64_t cap_;
+    std::list<Entry> lru_;
+    std::unordered_map<int64_t, std::list<Entry>::iterator> map_;
+};
+
+struct PleReader {
+    std::string path;
+    uint64_t    offset    = 0;
+    uint64_t    row_bytes = 0;
+    int64_t     n_rows    = 0;
+    uint64_t    block     = kPageGuess;
+    uint64_t    window    = 256;
+
+    int fd = -1;
+
+    std::unique_ptr<IOPool>   pool;
+    std::unique_ptr<RowCache> cache;
+
+    std::vector<uint8_t *> bufs;  // `window` buffers, each max_read_len bytes
+    uint64_t max_read_len = 0;
+
+    ~PleReader() {
+        if (fd >= 0) {
+            ::close(fd);
+            fd = -1;
+        }
+        for (uint8_t * p : bufs) {
+            free(p);
+        }
+        bufs.clear();
+    }
+
+    bool open() {
+        fd = ::open(path.c_str(), O_RDONLY | O_DIRECT);
+        if (fd < 0) {
+            // O_DIRECT unsupported: buffered pread still beats page faults via
+            // batching + de-duplication.
+            fd = ::open(path.c_str(), O_RDONLY);
+        }
+        if (fd < 0) {
+            return false;
+        }
+        struct stat st {};
+        if (fstat(fd, &st) == 0 && st.st_blksize >= 512) {
+            block = (uint64_t) st.st_blksize;
+        }
+        posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
+
+        max_read_len = 2 * block;
+        if (row_bytes > max_read_len) {
+            max_read_len = ((row_bytes + block - 1) / block) * block;
+        }
+        bufs.resize((size_t) window);
+        for (uint64_t i = 0; i < window; ++i) {
+            void * p = nullptr;
+            if (posix_memalign(&p, (size_t) block, (size_t) max_read_len) != 0) {
+                return false;
+            }
+            bufs[(size_t) i] = (uint8_t *) p;
+        }
+        return true;
+    }
+
+    bool gather(const int32_t * indices, int64_t n, uint8_t * dst) {
+        if (fd < 0 || n <= 0) {
+            return false;
+        }
+        const uint64_t rb = row_bytes;
+
+        // 1) cache hits
+        std::vector<int64_t> miss;
+        miss.reserve((size_t) n);
+        for (int64_t i = 0; i < n; ++i) {
+            const int64_t r = indices[i];
+            if (r < 0 || r >= n_rows) {
+                return false;
+            }
+            if (!cache->get(r, dst + (size_t) i * rb, rb)) {
+                miss.push_back(i);
+            }
+        }
+        if (miss.empty()) {
+            return true;
+        }
+
+        // 2) unique page-aligned read spans
+        struct Span {
+            uint64_t             off = 0;
+            uint64_t             len = 0;
+            std::vector<int64_t> rows;  // positions in dst
+        };
+        std::unordered_map<uint64_t, size_t> by_off;
+        std::vector<Span>                    spans;
+        spans.reserve(miss.size());
+        for (int64_t i : miss) {
+            const int64_t  r   = indices[i];
+            const uint64_t s   = offset + (uint64_t) r * rb;
+            const uint64_t e   = s + rb;
+            const uint64_t off = s & ~(block - 1);
+            uint64_t       len = ((e - off) + block - 1) & ~(block - 1);
+            if (len < block) {
+                len = block;
+            }
+            auto it = by_off.find(off);
+            if (it == by_off.end()) {
+                by_off.emplace(off, spans.size());
+                spans.push_back(Span{off, len, {i}});
+            } else {
+                Span & sp = spans[it->second];
+                if (len > sp.len) {
+                    sp.len = len;
+                }
+                sp.rows.push_back(i);
+            }
+        }
+
+        // 3) bounded windows of parallel reads
+        std::vector<ReadTask> tasks;
+        std::vector<int>      errs;
+        for (size_t base = 0; base < spans.size(); base += (size_t) window) {
+            const size_t cnt = std::min<size_t>((size_t) window, spans.size() - base);
+            tasks.assign(cnt, ReadTask{});
+            errs.assign(cnt, 0);
+            for (size_t k = 0; k < cnt; ++k) {
+                tasks[k].off = spans[base + k].off;
+                tasks[k].len = spans[base + k].len;
+                tasks[k].buf = bufs[k];
+            }
+            pool->run(fd, tasks, errs);
+            for (size_t k = 0; k < cnt; ++k) {
+                if (errs[k] != 0) {
+                    return false;
+                }
+                const Span & sp = spans[base + k];
+                for (int64_t i : sp.rows) {
+                    const int64_t  r   = indices[i];
+                    const uint64_t s   = offset + (uint64_t) r * rb;
+                    const uint8_t * src = bufs[k] + (size_t) (s - sp.off);
+                    uint8_t *       out = dst + (size_t) i * rb;
+                    std::memcpy(out, src, (size_t) rb);
+                    cache->put(r, out, rb);
+                }
+            }
+        }
+        return true;
+    }
+};
+
+#else  // !__linux__
+
+struct PleReader {};
+
+#endif  // __linux__
+
+std::mutex & registry_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+std::atomic<int> & registry_count() {
+    static std::atomic<int> c{0};
+    return c;
+}
+
+std::unordered_map<const ggml_tensor *, std::unique_ptr<PleReader>> & registry() {
+    static std::unordered_map<const ggml_tensor *, std::unique_ptr<PleReader>> r;
+    return r;
+}
+
+}  // namespace
+
+int ggml_ple_reader_register(const struct ggml_tensor * t, const struct ggml_ple_reader_config * cfg) {
+#if defined(__linux__)
+    if (t == nullptr || cfg == nullptr || cfg->path == nullptr || cfg->row_bytes == 0) {
+        return 0;
+    }
+    auto reader = std::make_unique<PleReader>();
+    reader->path      = cfg->path;
+    reader->offset    = cfg->offset;
+    reader->row_bytes = cfg->row_bytes;
+    reader->n_rows    = cfg->n_rows;
+    reader->window    = cfg->window == 0 ? 256 : cfg->window;
+    reader->pool      = std::make_unique<IOPool>(cfg->io_depth == 0 ? 16 : cfg->io_depth);
+    reader->cache     = std::make_unique<RowCache>(cfg->cache_rows == 0 ? 1000000 : cfg->cache_rows);
+    if (!reader->open()) {
+        return 0;
+    }
+    std::lock_guard<std::mutex> lk(registry_mutex());
+    registry()[t] = std::move(reader);
+    registry_count().store((int) registry().size(), std::memory_order_relaxed);
+    return 1;
+#else
+    GGML_UNUSED(t);
+    GGML_UNUSED(cfg);
+    return 0;
+#endif
+}
+
+int ggml_ple_reader_has(const struct ggml_tensor * t) {
+    if (t == nullptr || registry_count().load(std::memory_order_relaxed) == 0) {
+        return 0;
+    }
+    std::lock_guard<std::mutex> lk(registry_mutex());
+    return registry().count(t) != 0 ? 1 : 0;
+}
+
+int ggml_ple_reader_gather(const struct ggml_tensor * t,
+                           const int32_t * indices, int64_t n, void * raw_dst) {
+    if (t == nullptr || indices == nullptr || raw_dst == nullptr || n <= 0) {
+        return 0;
+    }
+#if defined(__linux__)
+    // the registry lock also serializes gather calls, which is all the reader
+    // needs because the CPU backend runs one op at a time
+    std::lock_guard<std::mutex> lk(registry_mutex());
+    auto it = registry().find(t);
+    if (it == registry().end()) {
+        return 0;
+    }
+    return it->second->gather(indices, n, (uint8_t *) raw_dst) ? 1 : 0;
+#else
+    GGML_UNUSED(t);
+    GGML_UNUSED(indices);
+    GGML_UNUSED(n);
+    GGML_UNUSED(raw_dst);
+    return 0;
+#endif
+}
+
+void ggml_ple_reader_clear(void) {
+    std::lock_guard<std::mutex> lk(registry_mutex());
+    registry().clear();
+    registry_count().store(0, std::memory_order_relaxed);
+}
