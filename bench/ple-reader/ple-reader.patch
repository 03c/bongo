diff --git a/ggml/include/ggml-ple-reader.h b/ggml/include/ggml-ple-reader.h
new file mode 100644
index 000000000..5bd714a6b
--- /dev/null
+++ b/ggml/include/ggml-ple-reader.h
@@ -0,0 +1,48 @@
+#pragma once
+// M3.4b PLE reader: a file-backed row gather that serves GGML_OP_GET_ROWS on a
+// huge, lazily-mapped weight tensor from a bounded O_DIRECT read pool plus an
+// LRU row cache instead of one page fault per row.
+//
+// The tensor stays memory-mapped as the fallback; this registry only changes how
+// the CPU backend serves GET_ROWS for tensors registered here.  Link in
+// ggml-base so both llama (registration) and the CPU backend (gathering) see one
+// registry.
+//
+// EXPERIMENTAL: benchmark/integration prototype for BAS-79.  Linux only.
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// geometry and tuning for one reader
+struct ggml_ple_reader_config {
+    const char * path;      // model shard to read from
+    uint64_t     offset;    // byte offset of row 0 in that file
+    uint64_t     row_bytes; // bytes per row (a whole row must fit two 4 KiB pages)
+    int64_t      n_rows;    // rows in the tensor
+    int          io_depth;  // O_DIRECT worker threads (0 = default 16)
+    uint64_t     cache_rows;// LRU row cache entries (0 = default 1000000)
+    uint64_t     window;    // max in-flight page reads per wave (0 = default 256)
+};
+
+// register a reader for `t`; a later call replaces an existing registration.
+// returns non-zero on success and zero when the reader could not be opened
+// (the caller keeps the mmap fallback).
+GGML_API int ggml_ple_reader_register(const struct ggml_tensor * t, const struct ggml_ple_reader_config * cfg);
+
+// non-zero when a reader serves GET_ROWS for `t`
+GGML_API int ggml_ple_reader_has(const struct ggml_tensor * t);
+
+// gather `n` rows (given by `indices`, int32 global row ids) into `raw_dst`
+// (n * row_bytes, in request order).  Returns non-zero on success.
+GGML_API int ggml_ple_reader_gather(const struct ggml_tensor * t,
+                                    const int32_t * indices, int64_t n, void * raw_dst);
+
+// drop every registration and close its file (used on model teardown/reload)
+GGML_API void ggml_ple_reader_clear(void);
+
+#ifdef __cplusplus
+}
+#endif
