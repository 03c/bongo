+// --- Slot checkpoint persistence (BAS-86) ---
+// On hybrid/recurrent models (e.g. qwen4exp) the engine keeps an in-RAM list of
+// "context checkpoints" (common_prompt_checkpoint, one per anchorable position
+// range) that let cache_prompt resume a prefix after the recurrent state can no
+// longer be shifted. Those checkpoints are ephemeral: slot save/restore only
+// round-trips the tokens + the sequence KV state, so an erased/restored slot has
+// an empty checkpoint list and the next request "forces full prompt re-processing".
+// The helpers below persist/restore that checkpoint list as a sidecar file next to
+// the slot KV, so a restored slot can reuse the prefix instead of re-prefilling.
+// The binary is gated on `--save-slot-checkpoints`; when it is disabled (the
+// shipped baseline default) nothing changes and the engine falls back to a full
+// re-prefill on a restored slot exactly as before.
+// Note: `erase` clears the in-RAM slot but deliberately leaves the sidecar on
+// disk, so a later `restore` of the same saved file can replay it. The erase
+// route carries no filename, so there is nothing to erase in any case.
+
+// sidecar path for a slot KV file written at `filepath`
+inline std::string slot_ckpt_path(const std::string & filepath) {
+    return filepath + ".ckpt";
+}
+
+// write the checkpoint list of `checkpoints` to `ckpt_path`.
+// returns true on success.
+static bool slot_checkpoints_save(
+        const std::string & ckpt_path,
+        const std::list<common_prompt_checkpoint> & checkpoints) {
+    std::ofstream out(ckpt_path, std::ios::binary);
+    if (!out.is_open()) {
+        return false;
+    }
+
+    const char            magic[4]  = {'B', 'K', 'C', 'P'};
+    const uint32_t        version   = 1;
+    const uint32_t        n         = static_cast<uint32_t>(checkpoints.size());
+
+    out.write(magic, sizeof(magic));
+    out.write(reinterpret_cast<const char *>(&version), sizeof(version));
+    out.write(reinterpret_cast<const char *>(&n), sizeof(n));
+
+    for (const auto & cp : checkpoints) {
+        const uint32_t u_pos_min = static_cast<uint32_t>(cp.pos_min);
+        const uint32_t u_pos_max = static_cast<uint32_t>(cp.pos_max);
+        const uint64_t len_tgt  = cp.data_tgt.size();
+        const uint64_t len_dft  = cp.data_dft.size();
+        const uint64_t len_spec = cp.data_spec.size();
+
+        out.write(reinterpret_cast<const char *>(&cp.n_tokens),  sizeof(cp.n_tokens));
+        out.write(reinterpret_cast<const char *>(&cp.id_task),   sizeof(cp.id_task));
+        out.write(reinterpret_cast<const char *>(&u_pos_min),    sizeof(u_pos_min));
+        out.write(reinterpret_cast<const char *>(&u_pos_max),    sizeof(u_pos_max));
+        out.write(reinterpret_cast<const char *>(&len_tgt),      sizeof(len_tgt));
+        out.write(reinterpret_cast<const char *>(cp.data_tgt.data()), len_tgt);
+        out.write(reinterpret_cast<const char *>(&len_dft),      sizeof(len_dft));
+        out.write(reinterpret_cast<const char *>(cp.data_dft.data()), len_dft);
+        out.write(reinterpret_cast<const char *>(&len_spec),     sizeof(len_spec));
+        out.write(reinterpret_cast<const char *>(cp.data_spec.data()), len_spec);
+    }
+
+    return out.good();
+}
+
+// load checkpoint list from `ckpt_path` into `checkpoints`.
+// returns true iff the file exists and is a readable BKC1 checkpoint file.
+static bool slot_checkpoints_load(
+        const std::string & ckpt_path,
+        std::list<common_prompt_checkpoint> & checkpoints) {
+    std::ifstream in(ckpt_path, std::ios::binary | std::ios::ate);
+    if (!in.is_open()) {
+        return false;
+    }
+
+    checkpoints.clear();
+
+    char             magic[4];
+    uint32_t         version = 0;
+    uint32_t         n       = 0;
+
+    in.seekg(0, std::ios::beg);
+    in.read(magic, sizeof(magic));
+    in.read(reinterpret_cast<char *>(&version), sizeof(version));
+    in.read(reinterpret_cast<char *>(&n), sizeof(n));
+    if (!in || magic[0] != 'B' || magic[1] != 'K' || magic[2] != 'C' || magic[3] != 'P' || version != 1) {
+        SRV_WRN("slot checkpoint sidecar has unknown format/version (%s, v%u); skipping checkpoint restore\n", ckpt_path.c_str(), version);
+        return false;
+    }
+
+    for (uint32_t i = 0; i < n; ++i) {
+        common_prompt_checkpoint cp;
+        uint32_t u_pos_min = 0;
+        uint32_t u_pos_max = 0;
+        uint64_t len_tgt = 0;
+        uint64_t len_dft = 0;
+        uint64_t len_spec = 0;
+
+        in.read(reinterpret_cast<char *>(&cp.n_tokens),  sizeof(cp.n_tokens));
+        in.read(reinterpret_cast<char *>(&cp.id_task),   sizeof(cp.id_task));
+        in.read(reinterpret_cast<char *>(&u_pos_min),    sizeof(u_pos_min));
+        in.read(reinterpret_cast<char *>(&u_pos_max),    sizeof(u_pos_max));
+        in.read(reinterpret_cast<char *>(&len_tgt),      sizeof(len_tgt));
+        cp.data_tgt.resize(len_tgt);
+        in.read(reinterpret_cast<char *>(cp.data_tgt.data()), static_cast<std::streamsize>(len_tgt));
+        in.read(reinterpret_cast<char *>(&len_dft),      sizeof(len_dft));
+        cp.data_dft.resize(len_dft);
+        in.read(reinterpret_cast<char *>(cp.data_dft.data()), static_cast<std::streamsize>(len_dft));
+        in.read(reinterpret_cast<char *>(&len_spec),     sizeof(len_spec));
+        cp.data_spec.resize(len_spec);
+        in.read(reinterpret_cast<char *>(cp.data_spec.data()), static_cast<std::streamsize>(len_spec));
+
+        cp.pos_min = static_cast<llama_pos>(u_pos_min);
+        cp.pos_max = static_cast<llama_pos>(u_pos_max);
+
+        if (!in) {
+            SRV_WRN("slot checkpoint sidecar truncated; restored %u/%u checkpoints\n", i, n);
+            return !checkpoints.empty();
+        }
+        checkpoints.push_back(std::move(cp));
+    }
+
+    return true;
+}
